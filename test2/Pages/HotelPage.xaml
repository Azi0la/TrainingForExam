<Page x:Class="test2.Pages.HotelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:test2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HotelPage"
      Background="Salmon">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Image Source="{Binding ImageUrl}" Width="200" Height="200"/>
            <TextBlock Text="{Binding Name}" FontSize="16"/>
            <TextBlock Text="{Binding City}" FontSize="16"/>
            <TextBlock Text="{Binding Address}" FontSize="16"/>
            <TextBlock Text="{Binding Description}" FontSize="16"/>
            <TextBlock Text="{Binding Stars, StringFormat=Оценка: {0}}" FontSize="16"/>
        </StackPanel>
        <Button x:Name="BackBTN" Width="100" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Left" 
                Margin="15" Content="Назад" FontSize="25" Click="BackBTN_Click"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Написать отзыв (1-5)" FontSize="26"/>
            <StackPanel Orientation="Horizontal">
                <Label Content="Чистота:" FontSize="16"/>
                <TextBox x:Name="ClearTB" Width="150" Height="25" TextChanged="ClearTB_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Сервис:" FontSize="16"/>
                <TextBox x:Name="ServiceTB" Width="150" Height="25" TextChanged="ClearTB_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Расположение:" FontSize="16"/>
                <TextBox x:Name="PlaceTB" Width="120" Height="25" TextChanged="ClearTB_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Цена/Качество:" FontSize="16"/>
                <TextBox x:Name="PriceTB" Width="120" Height="25" TextChanged="ClearTB_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Питание:" FontSize="16"/>
                <TextBox x:Name="FoodTB" Width="150" Height="25" TextChanged="ClearTB_TextChanged"/>
            </StackPanel>
            <Button x:Name="SendBTN" Height="50" Width="100" Margin="15" Content="Отправить" FontSize="16" IsEnabled="False" Click="SendBTN_Click"/>
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5*"/>
            </Grid.RowDefinitions>

            <Label Content="Отзывы" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ListBox Grid.Row="1" x:Name="ReviewList"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Users.Username}"/>
                            <TextBlock Text="{Binding OverallRating}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Grid>
</Page>
