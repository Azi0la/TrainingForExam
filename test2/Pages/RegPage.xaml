<Page x:Class="test2.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:test2.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage"
      Background="Salmon">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="1" Content="Регистрация" VerticalAlignment="Top" 
               HorizontalAlignment="Center" Margin="0,50,0,0" FontSize="30"/>
        
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Логин:" FontSize="20"/>
                <TextBox x:Name="LoginTB" Height="20" Width="150" Margin="5" TextChanged="LoginTB_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Пароль:" FontSize="20"/>
                <TextBox x:Name="PassTB" Height="20" Width="150" Margin="5" TextChanged="LoginTB_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Почта:" FontSize="20"/>
                <TextBox x:Name="EmailTB" Height="20" Width="150" Margin="5" TextChanged="LoginTB_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Имя:" FontSize="20"/>
                <TextBox x:Name="NameTB" Height="20" Width="150" Margin="5" TextChanged="LoginTB_TextChanged"/>
            </StackPanel>
            <Button x:Name="RegBTN" Height="50" Width="200" 
                    Content="Зарегистрироваться" FontSize="20" Click="RegBTN_Click" 
                    Margin="10" IsEnabled="False"/>
        </StackPanel>

    </Grid>
</Page>
