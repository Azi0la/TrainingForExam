<Page x:Class="_4.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Background="Salmon">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1">
            <Label Content="Название сборки:" FontSize="15"/>
            <TextBox x:Name="NameTB" Height="30" Width="175"/>
            <StackPanel Orientation="Horizontal">
                <Label x:Name="PriceLabel" Grid.Column="1" Content="Цена:" FontSize="15" Margin="0, 0,0,0"/>
                <Label x:Name="RealPriceLabel" Grid.Column="1" Content="" FontSize="15" Margin="0, 0,0,0"/>
            </StackPanel>
            <Button x:Name="SavedBTN" Grid.Column="1" Width="100" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" Content="К сохраненным &#x0a;      сборкам" Click="SavedBTN_Click"/>
            <Button x:Name="CompatBTN" Grid.Column="1" Width="100" Height="50" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" Content="Сохранить &#x0a;   сборку" IsEnabled="False" Click="CompatBTN_Click"/>
        </StackPanel>
        
        <StackPanel Grid.Column="0">
            
        <TabControl SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Кузов" Tag="1"/>
            <TabItem Header="Двигатель" Tag="2"/>
            <TabItem Header="Коробка передач" Tag="3"/>
            <TabItem Header="Колёса" Tag="4"/>
            <TabItem Header="Салон" Tag="5"/>
            <TabItem Header="Электроника" Tag="6"/>
        </TabControl>

        <ListBox x:Name="PartsLB" MouseDoubleClick="PartsLB_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Source="{Binding ImagePath}"/>
                        <TextBlock Text="{Binding Name}"/>
                        <TextBlock Text="{Binding Price, StringFormat=Цена: {0}}"/>
                        <TextBlock Text="{Binding Description}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </StackPanel>
    </Grid>
</Page>
