<Page x:Class="_4.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_4.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage"
      Background="Salmon">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Регистрация" FontSize="30" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal">
                <Label Content="Логин: " FontSize="20" />
                <TextBox x:Name="LoginTB" Width="150" Height="30" TextChanged="LoginTB_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Пароль: " FontSize="20" />
                <TextBox x:Name="PassTB" Width="150" Height="30" TextChanged="LoginTB_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Content="Почта: " FontSize="20" />
                <TextBox x:Name="EmailTB" Width="150" Height="30" TextChanged="LoginTB_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackBTN" Width="150" Height="50" Margin="10" Content="Назад" FontSize="20" Click="BackBTN_Click" />
                <Button x:Name="RegBTN" Width="150" Height="50" Content="Регистрация" FontSize="20" Click="RegBTN_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
