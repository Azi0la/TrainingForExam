<Page x:Class="_3.Pages.PayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PayPage"
      Background="Salmon">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label x:Name="PriceLB" FontSize="36"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Введите вносимую сумму: " FontSize="16"/>
                <TextBox x:Name="MoneyTB" Width="150" TextChanged="MoneyTB_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label x:Name="LeftLB" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="SendBTN" Height="40" Width="100" Content="Отправить" 
                    FontSize="16" IsEnabled="False" Click="SendBTN_Click"/>
        </StackPanel>
    </Grid>
</Page>
