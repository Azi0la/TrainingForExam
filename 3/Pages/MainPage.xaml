<Page x:Class="_3.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Background="Salmon">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Content="Едальня" FontSize="30" HorizontalAlignment="Center"/>
            <Button x:Name="ComboBTN" Height="50" Width="120" Content="Выбрать комбо" Margin="15" Click="ComboBTN_Click"/>
            <Button x:Name="ManualBTN" Height="50" Width="120" Content="Выбрать вручную" Margin="15" Click="ManualBTN_Click"/>
        </StackPanel>
    </Grid>
</Page>
