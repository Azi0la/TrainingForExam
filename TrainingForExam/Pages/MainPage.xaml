<Page x:Class="TrainingForExam.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrainingForExam.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      Background="Salmon">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="ВЫБИРАЙ" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,200" FontSize="30"/>
        <Button x:Name="HairBTN" Width="100" Height="50" Content="Выбрать &#x0a;прическу" Click="HairBTN_Click"/>
        <Button x:Name="MasterBTN" Width="100" Height="50" Content="Выбрать &#x0a;мастера" Grid.Column="2"/>
    </Grid>
</Page>
