<Page x:Class="TrainingForExam.Pages.HairListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrainingForExam.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HairListPage"
      Background="Salmon">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Выберите прическу" FontSize="32" VerticalAlignment="Center" Margin="10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="BackBTN" Width="100" Height="50" HorizontalAlignment="Right" VerticalAlignment="Center" 
                 Content="Назад" FontSize="26" Click="BackBTN_Click" Margin="0,0,10,0"/>
            <Button x:Name="SkipBTN" Width="100" Height="50" HorizontalAlignment="Right" VerticalAlignment="Center" 
                Content="Скип" FontSize="26" Click="SkipBTN_Click"/>
        </StackPanel>
        <ListBox Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="HairList" 
                 MouseDoubleClick="HairList_MouseDoubleClick" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Source="{Binding ImagePath}" Width="150" Height="150"/>
                        <TextBlock Text="{Binding Name}" FontSize="25"/>
                        <TextBlock Text="{Binding Price}" FontSize="16"/>
                        <TextBlock Text="{Binding Description}" FontSize="16"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Stretch">
                    </WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>  
        </ListBox>
    </Grid>
</Page>
